autonumber
skinparam responseMessageBelowArrow true
participant "BookingController" as p0
participant "BookingFacade" as p1
participant "BookingService" as p2
participant "PricingService" as p3
participant "Booking.Builder" as p4
participant "BookingRepository" as p5
